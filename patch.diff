@@ -0,0 +1,106 @@
+import { criarAdicionarQuimico, criarBeberFrasco } from './laboratorio';
+import { DEFAULT_LABORATORIO, CONFIG_LABORATORIO } from './defaults';
+
+// Helper to run a stateful sequence
+function makeLab() {
+  let lab = { ...DEFAULT_LABORATORIO, desbloqueado: true,
+              frascos: { ...DEFAULT_LABORATORIO.frascos }, grande: [] };
+  const setLaboratorio = (fn) => { lab = typeof fn === 'function' ? fn(lab) : fn; };
+  return { get: () => lab, setLaboratorio };
+}
+
+test('adicionarQuimico adds up to 3 and blocks re-add of same in flask', () => {
+  const { get, setLaboratorio } = makeLab();
+  let add = criarAdicionarQuimico({ laboratorio: get(), setLaboratorio });
+  add('green');
+  expect(get().grande).toEqual(['green']);
+  expect(get().frascos.green).toBe(-1);
+
+  // re-add same green blocked
+  add = criarAdicionarQuimico({ laboratorio: get(), setLaboratorio });
+  add('green');
+  expect(get().grande).toEqual(['green']);
+
+  add = criarAdicionarQuimico({ laboratorio: get(), setLaboratorio });
+  add('red'); 
+  add = criarAdicionarQuimico({ laboratorio: get(), setLaboratorio });
+  add('blue');
+  expect(get().grande).toEqual(['green','red','blue']);
+
+  // 4th blocked
+  add = criarAdicionarQuimico({ laboratorio: get(), setLaboratorio });
+  add('yellow');
+  expect(get().grande.length).toBe(3);
+});
+
+test('beberFrasco applies green instant cookies and sets cooldown', () => {
+  const { get, setLaboratorio } = makeLab();
+  // Only one green frask exists, so only 1 can be added at a time.
+  let add = criarAdicionarQuimico({ laboratorio: get(), setLaboratorio });
+  add('green');
+
+  let contagem = 0, totais = 0, ascTotais = 0;
+  const buffs = [];
+  const beber = criarBeberFrasco({
+    laboratorio: get(),
+    setLaboratorio,
+    setBuff: (fn) => { const r = fn(buffs); buffs.length=0; buffs.push(...r); },
+    setContagem: (fn) => { contagem = fn(contagem); },
+    setCookiesTotais: (fn) => { totais = fn(totais); },
+    setCookiesTotaisAscensao: (fn) => { ascTotais = fn(ascTotais); },
+    setDouradoDuracaoBonus: () => {},
+    producaoRef: { current: 100 }, // 100 cps
+    spawnCookieDourado: () => {},
+    mostrarAviso: () => {},
+    simplificarNumero: (n) => n,
+  });
+  beber();
+  // 1x green = 20 min => 100 cps * 60 * 20 = 120000
+  expect(contagem).toBe(100*60*20);
+  expect(totais).toBe(100*60*20);
+  expect(get().grande).toEqual([]);
+  expect(get().frascos.green).toBeGreaterThan(Date.now());
+});
+
+test('beberFrasco red+blue+yellow unlocks chemical cookie & spawns nothing', () => {
+  const { get, setLaboratorio } = makeLab();
+  let add;
+  ['red','blue','yellow'].forEach(c => {
+    add = criarAdicionarQuimico({ laboratorio: get(), setLaboratorio });
+    add(c);
+  });
+  let spawned = 0;
+  const buffs=[];
+  const beber = criarBeberFrasco({
+    laboratorio: get(), setLaboratorio,
+    setBuff: (fn)=>{const r=fn(buffs);buffs.length=0;buffs.push(...r);},
+    setContagem:()=>{}, setCookiesTotais:()=>{}, setCookiesTotaisAscensao:()=>{},
+    setDouradoDuracaoBonus:()=>{}, producaoRef:{current:0},
+    spawnCookieDourado:()=>{spawned++;}, mostrarAviso:()=>{}, simplificarNumero:n=>n,
+  });
+  beber();
+  expect(get().chemicalCookieDesbloqueado).toBe(true);
+  expect(spawned).toBe(0);
+  expect(buffs.length).toBe(0); // no buffs from this combo
+});
+
+test('beberFrasco red+green+yellow spawns golden', () => {
+  const { get, setLaboratorio } = makeLab();
+  ['red','green','yellow'].forEach(c => {
+    const add = criarAdicionarQuimico({ laboratorio: get(), setLaboratorio });
+    add(c);
+  });
+  let spawned = 0;
+  const beber = criarBeberFrasco({
+    laboratorio: get(), setLaboratorio,
+    setBuff:()=>{}, setContagem:()=>{}, setCookiesTotais:()=>{}, setCookiesTotaisAscensao:()=>{},
+    setDouradoDuracaoBonus:()=>{}, producaoRef:{current:0},
+    spawnCookieDourado:()=>{spawned++;}, mostrarAviso:()=>{}, simplificarNumero:n=>n,
+  });
+  beber();
+  expect(spawned).toBe(1);
+});
+
+test('cooldown constant is 30 minutes', () => {
+  expect(CONFIG_LABORATORIO.COOLDOWN).toBe(30*60*1000);
+});
diff --git a/src/laboratorio.js b/src/laboratorio.js
new file mode 100644
index 0000000..d1af6ac
--- /dev/null
+++ b/src/laboratorio.js
@@ -0,0 +1,367 @@
+// Módulo do minigame do Laboratório (mistura de químicos).
+//
+// Seguindo a arquitetura do minigame.js e sorte.js, as funções aqui são
+// "factories": recebem os setters e valores do estado do App e devolvem uma
+// função pronta pra ser chamada.
+//
+// Regras dos químicos:
+//  - green: cookies instantâneos (minutos de produção)
+//  - red: boost de clique de curta duração
+//  - blue: boost de CPS de longa duração
+//  - yellow: bônus de sorte (ou cookie dourado instantâneo com 3x)
+//  - combinações de 3 cores diferentes têm efeitos especiais.
+// Cada frasco pode ser usado uma vez e depois entra em cooldown de 30 minutos.
+
+import { CONFIG_LABORATORIO } from './defaults';
+
+// Ordem canônica das cores (usada pra comparar combinações).
+export const CORES = ['green', 'red', 'blue', 'yellow'];
+
+// Nome amigável de cada cor (em português) pra tooltips e avisos.
+export const NOME_COR = {
+  green: 'verde',
+  red: 'vermelho',
+  blue: 'azul',
+  yellow: 'amarelo',
+};
+
+// Conta quantos de cada cor há na mistura.
+// Retorna um objeto tipo { green: 2, red: 1 }.
+export function contarCores(grande) {
+  const contagem = {};
+  grande.forEach(cor => {
+    contagem[cor] = (contagem[cor] || 0) + 1;
+  });
+  return contagem;
+}
+
+// Descreve o conteúdo do frasco grande em texto (pra tooltip).
+export function descreverGrande(grande) {
+  if (grande.length === 0) return 'Frasco grande vazio. Arraste um químico para começar.';
+
+  const contagem = contarCores(grande);
+  const partes = CORES
+    .filter(cor => contagem[cor])
+    .map(cor => `${contagem[cor]} ${NOME_COR[cor]}`);
+
+  const restantes = 3 - grande.length;
+  const sufixo = restantes > 0
+    ? `, você pode beber ou adicionar mais ${restantes}`
+    : ', você pode beber';
+
+  return `Contém ${partes.join(', ')}${sufixo}`;
+}
+
+// Retorna true se o químico dessa cor está disponível (fora de cooldown).
+export function estaDisponivel(laboratorio, cor) {
+  const cd = laboratorio.frascos?.[cor] || 0;
+  if (cd === -1) return false; // já está no frasco grande
+  return cd <= Date.now();
+}
+
+// Calcula os efeitos de uma mistura. Função pura: só descreve o que fazer.
+// Retorna um objeto com as ações a executar:
+//   { cookiesMinutos, clickBoost:{mult,duracao}, cpsBoost:{mult,duracao},
+//     sorteBoost:{duracao}, golden:bool, buildingDesconto:{pct,duracao},
+//     douradoDuracao:{pct,duracao}, unlockChemicalCookie:bool, avisos:[] }
+export function calcularEfeitos(grande) {
+  const contagem = contarCores(grande);
+  const coresDistintas = Object.keys(contagem);
+  const resultado = { avisos: [] };
+
+  // Combinações especiais: exatamente 3 cores diferentes (1 de cada).
+  if (grande.length === 3 && coresDistintas.length === 3) {
+    const set = new Set(coresDistintas);
+    const tem = c => set.has(c);
+
+    if (tem('red') && tem('green') && tem('blue')) {
+      resultado.buildingDesconto = { pct: 0.2, duracao: 5 * 60 };
+      resultado.avisos.push('Construções 20% mais baratas por 5 minutos!');
+      return resultado;
+    }
+    if (tem('red') && tem('green') && tem('yellow')) {
+      resultado.golden = true;
+      resultado.avisos.push('Um Cookie Dourado foi invocado!');
+      return resultado;
+    }
+    if (tem('red') && tem('blue') && tem('yellow')) {
+      resultado.unlockChemicalCookie = true;
+      resultado.avisos.push('Você desbloqueou o upgrade "Cookie Químico"!');
+      return resultado;
+    }
+    if (tem('blue') && tem('green') && tem('yellow')) {
+      resultado.douradoDuracao = { pct: 0.1, duracao: 10 * 60 };
+      resultado.avisos.push('Cookies Dourados duram 10% mais pelos próximos 10 minutos!');
+      return resultado;
+    }
+  }
+
+  // Caso contrário: soma os efeitos individuais por cor.
+  Object.entries(contagem).forEach(([cor, n]) => {
+    if (cor === 'green') {
+      const minutos = n === 1 ? 20 : n === 2 ? 40 : 60;
+      resultado.cookiesMinutos = (resultado.cookiesMinutos || 0) + minutos;
+      resultado.avisos.push(`+${minutos} minutos de produção`);
+    } else if (cor === 'red') {
+      const mult = n === 1 ? 10 : n === 2 ? 15 : 20;
+      resultado.clickBoost = { mult, duracao: 10 };
+      resultado.avisos.push(`Clique x${mult} por 10 segundos`);
+    } else if (cor === 'blue') {
+      let mult, duracao;
+      if (n === 1) { mult = 1.1; duracao = 3600; }
+      else if (n === 2) { mult = 1.2; duracao = 3600; }
+      else { mult = 1.2; duracao = 10 * 3600; }
+      resultado.cpsBoost = { mult, duracao };
+      const pct = Math.round((mult - 1) * 100);
+      const horas = duracao / 3600;
+      resultado.avisos.push(`+${pct}% de CPS por ${horas} hora${horas > 1 ? 's' : ''}`);
+    } else if (cor === 'yellow') {
+      if (n === 3) {
+        resultado.golden = true;
+        resultado.avisos.push('Um Cookie Dourado foi invocado!');
+      } else {
+        const duracao = n === 1 ? 3 * 60 : 10 * 60;
+        resultado.sorteBoost = { valor: 1, duracao };
+        resultado.avisos.push(`+1 de sorte por ${duracao / 60} minutos`);
+      }
+    }
+  });
+
+  return resultado;
+}
+
+// Factory: cria a função que adiciona um químico ao frasco grande.
+// Só adiciona se o químico está disponível e ainda cabe (máximo 3).
+export function criarAdicionarQuimico({ laboratorio, setLaboratorio }) {
+  return function adicionarQuimico(cor) {
+    setLaboratorio(prev => {
+      if (!prev.desbloqueado) return prev;
+      if (prev.grande.length >= 3) return prev;
+      const cd = prev.frascos?.[cor] || 0;
+      if (cd === -1) return prev; // já está no frasco grande
+      if (cd > Date.now()) return prev; // em cooldown
+      return {
+        ...prev,
+        grande: [...prev.grande, cor],
+        frascos: {
+          ...prev.frascos,
+          // Marca o químico como "em uso" imediatamente (cooldown começa ao beber).
+          // Enquanto está no frasco grande, ele não pode ser re-adicionado.
+          [cor]: -1,
+        },
+      };
+    });
+  };
+}
+
+// Factory: cria a função que "bebe" o frasco grande, aplicando os efeitos
+// e colocando os químicos usados em cooldown de 30 minutos.
+export function criarBeberFrasco({
+  laboratorio,
+  setLaboratorio,
+  setBuff,
+  setContagem,
+  setCookiesTotais,
+  setCookiesTotaisAscensao,
+  setDouradoDuracaoBonus,
+  producaoRef,
+  spawnCookieDourado,
+  mostrarAviso,
+  simplificarNumero,
+}) {
+  return function beberFrasco() {
+    const grande = laboratorio.grande;
+    if (!grande || grande.length === 0) return;
+
+    const efeitos = calcularEfeitos(grande);
+    const agora = Date.now();
+
+    // Cookies instantâneos (green)
+    if (efeitos.cookiesMinutos) {
+      const cps = producaoRef.current || 0;
+      const ganho = cps * 60 * efeitos.cookiesMinutos;
+      setContagem(v => v + ganho);
+      setCookiesTotais(v => v + ganho);
+      setCookiesTotaisAscensao(v => v + ganho);
+    }
+
+    // Boost de clique (red)
+    if (efeitos.clickBoost) {
+      setBuff(prev => [...prev, {
+        nome: 'Reação Explosiva',
+        tipo: 'Click',
+        mult: efeitos.clickBoost.mult,
+        expira: agora + efeitos.clickBoost.duracao * 1000,
+      }]);
+    }
+
+    // Boost de CPS (blue)
+    if (efeitos.cpsBoost) {
+      setBuff(prev => [...prev, {
+        nome: 'Catalisador de Produção',
+        tipo: 'CPS',
+        mult: efeitos.cpsBoost.mult,
+        expira: agora + efeitos.cpsBoost.duracao * 1000,
+      }]);
+    }
+
+    // Bônus de sorte (yellow 1x/2x)
+    if (efeitos.sorteBoost) {
+      setBuff(prev => [...prev, {
+        nome: 'Elixir da Sorte',
+        tipo: 'Sorte',
+        mult: efeitos.sorteBoost.valor,
+        expira: agora + efeitos.sorteBoost.duracao * 1000,
+      }]);
+    }
+
+    // Desconto em construções (red+green+blue)
+    if (efeitos.buildingDesconto) {
+      setBuff(prev => [...prev, {
+        nome: 'Solvente Corrosivo',
+        tipo: 'Desconto',
+        mult: efeitos.buildingDesconto.pct,
+        expira: agora + efeitos.buildingDesconto.duracao * 1000,
+      }]);
+    }
+
+    // Aumento de duração dos cookies dourados (blue+green+yellow)
+    if (efeitos.douradoDuracao && setDouradoDuracaoBonus) {
+      setDouradoDuracaoBonus({
+        pct: efeitos.douradoDuracao.pct,
+        expira: agora + efeitos.douradoDuracao.duracao * 1000,
+      });
+    }
+
+    // Cookie dourado instantâneo (yellow 3x, ou red+green+yellow)
+    if (efeitos.golden && spawnCookieDourado) {
+      spawnCookieDourado();
+    }
+
+    // Desbloqueio do upgrade Cookie Químico (red+blue+yellow)
+    // (marca a flag no próprio estado do laboratório).
+
+    // Aviso do que aconteceu
+    if (efeitos.avisos.length > 0) {
+      mostrarAviso(`Laboratório: ${efeitos.avisos.join(' • ')}`);
+    }
+
+    // Coloca em cooldown os químicos usados e esvazia o frasco grande.
+    setLaboratorio(prev => {
+      const novosFrascos = { ...prev.frascos };
+      grande.forEach(cor => {
+        novosFrascos[cor] = agora + CONFIG_LABORATORIO.COOLDOWN;
+      });
+      return {
+        ...prev,
+        grande: [],
+        frascos: novosFrascos,
+        chemicalCookieDesbloqueado:
+          prev.chemicalCookieDesbloqueado || !!efeitos.unlockChemicalCookie,
+      };
+    });
+  };
+}
+
+// Componente da UI do minigame do Laboratório.
+export function Laboratorio({
+  laboratorio,
+  spriteSheet,
+  adicionarQuimico,
+  beberFrasco,
+}) {
+  const tamanho = 64;
+  const { spriteY, sprites } = CONFIG_LABORATORIO;
+
+  const now = Date.now();
+
+  // Estilo de um ícone de frasco do spritesheet.
+  // px = tamanho desejado na tela. Escalamos o background proporcionalmente
+  // para que sprites maiores (frasco grande) mostrem o slot inteiro.
+  const estiloSprite = (spriteX, px) => {
+    const escala = px / tamanho;
+    return {
+      width: px,
+      height: px,
+      backgroundImage: `url(${spriteSheet})`,
+      backgroundPosition: `-${spriteX * tamanho * escala}px -${spriteY * tamanho * escala}px`,
+      backgroundSize: `${16 * tamanho * escala}px ${16 * tamanho * escala}px`,
+      imageRendering: 'pixelated',
+      display: 'inline-block',
+    };
+  };
+
+  // Cor da primeira do frasco grande (ou vazio).
+  const spriteGrande = laboratorio.grande.length > 0
+    ? sprites[laboratorio.grande[0]]
+    : sprites.vazio;
+
+  return (
+    <div className="seção-laboratorio">
+      <h2>Laboratório</h2>
+
+      {/* Frascos pequenos no topo */}
+      <div className="lab-frascos-linha">
+        {CORES.map(cor => {
+          const cd = laboratorio.frascos?.[cor] || 0;
+          const emCooldown = cd > now;
+          const emUso = cd === -1;
+          const disponivel = !emCooldown && !emUso;
+          const spriteX = disponivel ? sprites[cor] : sprites.vazio;
+          const segundos = emCooldown ? Math.ceil((cd - now) / 1000) : 0;
+          const minutos = Math.floor(segundos / 60);
+          const seg = segundos % 60;
+
+          return (
+            <div key={cor} className="lab-frasco-item">
+              <div
+                className={`lab-frasco-pequeno ${disponivel ? 'lab-disponivel' : 'lab-indisponivel'}`}
+                draggable={disponivel}
+                onDragStart={e => {
+                  e.dataTransfer.setData('text/plain', cor);
+                }}
+                onClick={() => disponivel && adicionarQuimico(cor)}
+                title={
+                  disponivel
+                    ? `Químico ${NOME_COR[cor]} — arraste ou clique para adicionar`
+                    : emUso
+                      ? 'Já está no frasco grande'
+                      : `Em cooldown: ${minutos}:${seg.toString().padStart(2, '0')}`
+                }
+                style={{ ...estiloSprite(spriteX, tamanho), cursor: disponivel ? 'grab' : 'not-allowed' }}
+              />
+              {emCooldown && (
+                <div className="lab-cooldown">{minutos}:{seg.toString().padStart(2, '0')}</div>
+              )}
+            </div>
+          );
+        })}
+      </div>
+
+      {/* Frasco grande no meio */}
+      <div className="lab-frasco-grande-wrapper">
+        <div
+          className="lab-frasco-grande"
+          title={descreverGrande(laboratorio.grande)}
+          onDragOver={e => e.preventDefault()}
+          onDrop={e => {
+            e.preventDefault();
+            const cor = e.dataTransfer.getData('text/plain');
+            if (cor) adicionarQuimico(cor);
+          }}
+          style={estiloSprite(spriteGrande, 96)}
+        />
+      </div>
+
+      {/* Botão de beber */}
+      <button
+        className="lab-beber-botao"
+        onClick={beberFrasco}
+        disabled={laboratorio.grande.length === 0}
+        style={{ cursor: laboratorio.grande.length === 0 ? 'not-allowed' : 'pointer' }}
+      >
+        Beber
+      </button>
+    </div>
+  );
+}
