+import { render, screen, fireEvent } from '@testing-library/react';
+import { Laboratorio } from './laboratorio';
+import { DEFAULT_LABORATORIO } from './defaults';
+
+test('renders lab UI with drink button disabled when empty', () => {
+  const add = jest.fn();
+  const beber = jest.fn();
+  render(
+    <Laboratorio
+      laboratorio={{ ...DEFAULT_LABORATORIO, desbloqueado: true, frascos:{green:0,red:0,blue:0,yellow:0}, grande: [] }}
+      spriteSheet="x.png"
+      adicionarQuimico={add}
+      beberFrasco={beber}
+    />
+  );
+  const btn = screen.getByText('Beber');
+  expect(btn).toBeDisabled();
+});
+
+test('clicking available flask calls adicionarQuimico', () => {
+  const add = jest.fn();
+  const { container } = render(
+    <Laboratorio
+      laboratorio={{ ...DEFAULT_LABORATORIO, desbloqueado: true, frascos:{green:0,red:0,blue:0,yellow:0}, grande: [] }}
+      spriteSheet="x.png"
+      adicionarQuimico={add}
+      beberFrasco={()=>{}}
+    />
+  );
+  const flasks = container.querySelectorAll('.lab-frasco-pequeno');
+  fireEvent.click(flasks[0]);
+  expect(add).toHaveBeenCalledWith('green');
+});
+
+test('drink enabled and callable when flask has contents', () => {
+  const beber = jest.fn();
+  render(
+    <Laboratorio
+      laboratorio={{ ...DEFAULT_LABORATORIO, desbloqueado: true, frascos:{green:-1,red:0,blue:0,yellow:0}, grande: ['green'] }}
+      spriteSheet="x.png"
+      adicionarQuimico={()=>{}}
+      beberFrasco={beber}
+    />
+  );
+  const btn = screen.getByText('Beber');
+  expect(btn).not.toBeDisabled();
+  fireEvent.click(btn);
+  expect(beber).toHaveBeenCalled();
+});
diff --git a/src/laboratorio.test.js b/src/laboratorio.test.js
new file mode 100644
index 0000000..0bf71ca
--- /dev/null
+++ b/src/laboratorio.test.js
@@ -0,0 +1,55 @@
+import { contarCores, descreverGrande, calcularEfeitos, estaDisponivel, CORES } from './laboratorio';
+
+test('contarCores counts colors', () => {
+  expect(contarCores(['green','green','red'])).toEqual({green:2, red:1});
+});
+
+test('green effects', () => {
+  expect(calcularEfeitos(['green']).cookiesMinutos).toBe(20);
+  expect(calcularEfeitos(['green','green']).cookiesMinutos).toBe(40);
+  expect(calcularEfeitos(['green','green','green']).cookiesMinutos).toBe(60);
+});
+
+test('red click boost', () => {
+  expect(calcularEfeitos(['red']).clickBoost).toEqual({mult:10,duracao:10});
+  expect(calcularEfeitos(['red','red']).clickBoost).toEqual({mult:15,duracao:10});
+  expect(calcularEfeitos(['red','red','red']).clickBoost).toEqual({mult:20,duracao:10});
+});
+
+test('blue cps boost', () => {
+  expect(calcularEfeitos(['blue']).cpsBoost).toEqual({mult:1.1,duracao:3600});
+  expect(calcularEfeitos(['blue','blue']).cpsBoost).toEqual({mult:1.2,duracao:3600});
+  expect(calcularEfeitos(['blue','blue','blue']).cpsBoost).toEqual({mult:1.2,duracao:36000});
+});
+
+test('yellow luck / golden', () => {
+  expect(calcularEfeitos(['yellow']).sorteBoost).toEqual({valor:1,duracao:180});
+  expect(calcularEfeitos(['yellow','yellow']).sorteBoost).toEqual({valor:1,duracao:600});
+  expect(calcularEfeitos(['yellow','yellow','yellow']).golden).toBe(true);
+});
+
+test('combined 2 blue + 1 red', () => {
+  const e = calcularEfeitos(['blue','blue','red']);
+  expect(e.cpsBoost).toEqual({mult:1.2,duracao:3600});
+  expect(e.clickBoost).toEqual({mult:10,duracao:10});
+});
+
+test('special 3-color combos', () => {
+  expect(calcularEfeitos(['red','green','blue']).buildingDesconto).toEqual({pct:0.2,duracao:300});
+  expect(calcularEfeitos(['red','green','yellow']).golden).toBe(true);
+  expect(calcularEfeitos(['red','blue','yellow']).unlockChemicalCookie).toBe(true);
+  expect(calcularEfeitos(['blue','green','yellow']).douradoDuracao).toEqual({pct:0.1,duracao:600});
+});
+
+test('descreverGrande text', () => {
+  expect(descreverGrande([])).toMatch(/vazio/);
+  expect(descreverGrande(['red'])).toMatch(/1 vermelho/);
+  expect(descreverGrande(['red'])).toMatch(/adicionar mais 2/);
+  expect(descreverGrande(['red','red','red'])).toMatch(/beber/);
+});
+
+test('estaDisponivel', () => {
+  expect(estaDisponivel({frascos:{green:0}}, 'green')).toBe(true);
+  expect(estaDisponivel({frascos:{green:Date.now()+10000}}, 'green')).toBe(false);
+  expect(estaDisponivel({frascos:{green:-1}}, 'green')).toBe(false);
+});
