@@ -0,0 +1,23 @@
+import { filtrarUpgradesDisponiveis, DEFAULT_MELHORIAS, DEFAULT_CONSTRUCOES, DEFAULT_ASCENSAO, DEFAULT_LABORATORIO } from './defaults';
+
+test('chemical cookie hidden until unlocked', () => {
+  const construcoes = DEFAULT_CONSTRUCOES.map(c => ({...c, quantidade: 999}));
+  const locked = filtrarUpgradesDisponiveis(
+    DEFAULT_MELHORIAS, construcoes, 1e18, 1000, DEFAULT_ASCENSAO,
+    { ...DEFAULT_LABORATORIO, chemicalCookieDesbloqueado: false });
+  expect(locked.find(m => m.id === 'chemicalcookie')).toBeUndefined();
+
+  const unlocked = filtrarUpgradesDisponiveis(
+    DEFAULT_MELHORIAS, construcoes, 1e18, 1000, DEFAULT_ASCENSAO,
+    { ...DEFAULT_LABORATORIO, chemicalCookieDesbloqueado: true });
+  const cc = unlocked.find(m => m.id === 'chemicalcookie');
+  expect(cc).toBeDefined();
+  expect(cc.efeito).toBe('5porcento');
+  expect(cc.preço).toBe(1_000_000_000_000);
+});
+
+test('DEFAULT_LABORATORIO shape', () => {
+  expect(DEFAULT_LABORATORIO.desbloqueado).toBe(false);
+  expect(DEFAULT_LABORATORIO.grande).toEqual([]);
+  expect(DEFAULT_LABORATORIO.frascos).toEqual({green:0,red:0,blue:0,yellow:0});
+});
